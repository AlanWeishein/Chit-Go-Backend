# Copiar como .env (no se sube al repo) y cambiar lo que haga falta.
# Si no hay .env, docker compose usa estos mismos valores por defecto,
# que son los que espera application.yml.
MYSQL_ROOT_PASSWORD=root
DB_NAME=chitgo
DB_USER=chitgo
DB_PASSWORD=chitgo

# Puerto de la compu donde queda MySQL. Es 3307 para no chocar con un MySQL
# instalado. Si lo cambiás, corré el back con DB_URL=jdbc:mysql://localhost:<puerto>/chitgo
DB_PORT=3307

# Clave para firmar el JWT de la sesión: 32 bytes o más, en Base64. La lee el back, no Docker,
# así que va en las variables de entorno de la configuración de IntelliJ (o de la terminal).
# Para generar una: openssl rand -base64 32
# Si no está, el back arranca igual con una clave al azar y las sesiones se pierden al reiniciarlo.
# Ejemplo (no usar fuera de tu compu):
JWT_CLAVE=q0ZqEhfvXC8B1e3mRk0yS9Xb3o4m3G6w5dYc7p2Lh1U=
