  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET','HEAD','OPTIONS'].includes(pm.request.method)) {",
          "  const csrf = pm.cookies.get('XSRF-TOKEN');",
          "  if (csrf) pm.request.headers.upsert({key:'X-XSRF-TOKEN',value:csrf});",
          "}"
        ]
      }
    }
  ],
  "item": [
